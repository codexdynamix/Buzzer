
# Server Configuration
PORT=5000
NODE_ENV=development

# Security
JWT_SECRET=generate-a-secure-random-string-here

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/whisp-chat
MONGODB_DB_NAME=whisp-chat

# Redis Configuration (Required)
REDIS_URL=redis://localhost:6379

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Note: In production, never commit the actual .env file
# Generate secure values for all credentials
# Store production credentials in a secure vault or environment management system
