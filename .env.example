# ── Supabase Postgres & Auth ──────────────────────────
SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUz...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUz...

# ── Redis Multi-Server Clustering (Scale Mode) ──────────
# Leave blank for local/single-server mode (uses in-memory adapter).
# When scaling to >100,000 users across multiple server instances,
# provide your connection URL (e.g. rediss://default:password@host:6379)
REDIS_URL=

# ── Optional Server Settings ───────────────────────────
CORS_ORIGIN=*